---
// Captioned, optimized image for blog posts (MDX).
// Usage: <Figure src={importedImage} alt="..." caption="..." />
// Renders at the image's natural width up to the prose column, never upscaled.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
const display = Math.min(src.width, 672);
const widths = [...new Set([display, Math.min(src.width, display * 2)])];
---

<figure>
	<Image
		src={src}
		alt={alt}
		widths={widths}
		sizes={`(min-width: 720px) ${display}px, 100vw`}
		loading="lazy"
		decoding="async"
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
