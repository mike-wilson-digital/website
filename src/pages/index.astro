---
import Layout from '../layouts/Layout.astro';
import SignupForm from '../components/SignupForm.astro';
---

<Layout
	title="Mike Wilson Digital — AI-first website workflow"
	description="Building an AI-first workflow to ship production websites fast — Astro, Cloudflare, and AI. Follow the build and get the starter kit before anyone else."
	ogTitle="The AI-first workflow I use to ship websites fast"
	ogDescription="The exact Astro + Cloudflare + AI setup I use to ship production sites fast. Building in the open — get the kit first."
>
	<main class="mx-auto flex w-full max-w-2xl flex-1 flex-col items-center justify-center px-6 py-16">
		<div class="flex w-full flex-col items-center text-center">
			<p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-text-muted">Mike Wilson Digital</p>

			<h1
				class="mt-4 font-heading text-4xl font-black leading-[1.08] tracking-tight text-text sm:text-5xl"
			>
				The <span class="text-gradient-animated">AI-first</span> workflow I use to ship websites fast
			</h1>

			<p class="mt-6 max-w-xl text-lg leading-relaxed text-text-muted">
				The exact Astro + Cloudflare + AI setup I use to ship production sites fast — packaged so you can
				clone it and make it your own. I'm building it in the open. Drop your email and you'll be first.
			</p>

			<SignupForm class="mt-8" />

			<!-- Secondary: link to the contact page -->
			<p class="mt-8 text-sm text-text-muted">
				Have a question?{' '}
				<a
					href="/contact"
					class="rounded-sm underline underline-offset-2 transition-colors hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
					>Contact me</a
				>
			</p>
		</div>
	</main>
</Layout>
