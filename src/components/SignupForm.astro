---
// Kit email signup — combined "pill" field. Reused on / and /links.
// Same endpoint / field / double-opt-in success + error handling.
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<form id="signup-form" class:list={['w-full max-w-lg', className]} novalidate>
	<div class="signup-pill">
		<label for="email_address" class="sr-only">Email address</label>
		<input
			id="email_address"
			name="email_address"
			type="email"
			required
			aria-required="true"
			autocomplete="email"
			placeholder="Enter your email"
		/>
		<button
			id="signup-btn"
			type="submit"
			class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cta px-6 py-3 font-mono text-sm font-medium uppercase tracking-wide text-white shadow-lg shadow-cta/20 transition hover:bg-cta-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto sm:shadow-none"
		>
			<span data-label>Get early access</span>
		</button>
	</div>

	<!-- Honeypot: hidden from humans; bots that fill it are rejected -->
	<div
		aria-hidden="true"
		style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;"
	>
		<input type="text" name="hp_field" tabindex="-1" autocomplete="off" />
	</div>

	<p class="mt-3 text-xs text-text-muted">No spam. Unsubscribe anytime.</p>
	<div id="signup-status" class="form-status" hidden></div>
</form>

<style>
	/* Signature: an always-on, slow conic-gradient ring on the signup field —
	   mostly-dim with one brighter arc drifting around (~5.5s). Pure CSS via an
	   animatable --a angle. Button stays inside the ring. (§9, approved 2026-08-07) */
	@property --a {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}

	@keyframes signup-ring-spin {
		to {
			--a: 360deg;
		}
	}

	/* The drifting ring: a two-layer background (solid fill + conic border-box). */
	.signup-pill,
	.signup-pill input {
		--ring: conic-gradient(
			from var(--a),
			rgba(221, 51, 0, 0.16) 0 235deg,
			#ff5a2a 300deg,
			rgba(221, 51, 0, 0.16) 350deg
		);
	}

	/* Combined email signup "pill": stacks on mobile, one ringed pill with the
	   button tucked inside on sm+ screens. */
	.signup-pill {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.signup-pill input {
		width: 100%;
		font-family: var(--font-mono); /* form controls = mono */
		font-size: 1rem;
		color: var(--text);
		border: 1.5px solid transparent;
		border-radius: var(--radius);
		/* Mobile (stacked): the ring lives on the input itself. */
		background:
			linear-gradient(var(--bg), var(--bg)) padding-box,
			var(--ring) border-box;
		animation: signup-ring-spin 5.5s linear infinite;
		padding: 0.9rem 1rem;
		outline: none;
		caret-color: var(--primary);
		transition: box-shadow 0.15s ease;
	}

	.signup-pill input::placeholder {
		color: var(--text-muted);
	}

	.signup-pill input:focus {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
	}

	/* Combined pill on wider screens: the ring moves to the whole pill. */
	@media (min-width: 640px) {
		.signup-pill {
			flex-direction: row;
			align-items: center;
			gap: 0.5rem;
			border: 1.5px solid transparent;
			border-radius: var(--radius);
			background:
				linear-gradient(var(--bg), var(--bg)) padding-box,
				var(--ring) border-box;
			animation: signup-ring-spin 5.5s linear infinite;
			padding: 0.4rem 0.4rem 0.4rem 1rem;
			transition: box-shadow 0.15s ease;
		}

		.signup-pill:focus-within {
			box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
		}

		.signup-pill input {
			flex: 1;
			width: auto;
			border: 0;
			background: transparent;
			border-radius: 0;
			padding: 0.5rem 0.5rem 0.5rem 0;
			animation: none;
			box-shadow: none;
		}

		.signup-pill input:focus {
			box-shadow: none; /* the pill container carries the ring/focus */
		}
	}

	/* Reduced motion: freeze the ring to a static orange outline. */
	@media (prefers-reduced-motion: reduce) {
		.signup-pill,
		.signup-pill input {
			animation: none;
			transition: none;
		}

		.signup-pill input {
			background:
				linear-gradient(var(--bg), var(--bg)) padding-box,
				linear-gradient(rgba(221, 51, 0, 0.6), rgba(221, 51, 0, 0.6)) border-box;
		}
	}

	@media (min-width: 640px) and (prefers-reduced-motion: reduce) {
		.signup-pill {
			background:
				linear-gradient(var(--bg), var(--bg)) padding-box,
				linear-gradient(rgba(221, 51, 0, 0.6), rgba(221, 51, 0, 0.6)) border-box;
		}

		.signup-pill input {
			background: transparent;
		}
	}
</style>

<script>
	function initSignup() {
		const form = document.getElementById('signup-form') as HTMLFormElement | null;
		if (!form) return;
		const statusEl = document.getElementById('signup-status') as HTMLDivElement;
		const submitBtn = document.getElementById('signup-btn') as HTMLButtonElement;
		const btnLabel = submitBtn.querySelector('[data-label]') as HTMLElement;

		// Kit (ConvertKit) form endpoint. Form ID is public — safe to commit.
		const KIT_ENDPOINT = 'https://app.kit.com/forms/9768960/subscriptions';

		const SUCCESS_MSG =
			'Almost there — I just sent you a confirmation email. Click the link inside to lock in your spot, and you’ll be first to get the kit.';
		const ERROR_MSG = 'Something went wrong — give it another try in a sec.';

		const setStatus = (state: 'success' | 'error', message: string) => {
			statusEl.hidden = false;
			statusEl.dataset.state = state;
			statusEl.setAttribute('role', state === 'error' ? 'alert' : 'status');
			const icon = state === 'success' ? '✓' : '⚠';
			statusEl.innerHTML = `<span class="status-icon" aria-hidden="true">${icon}</span><span>${message}</span>`;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			// Honeypot: if a bot filled the hidden field, feign success and bail.
			const hp = form.elements.namedItem('hp_field') as HTMLInputElement | null;
			if (hp && hp.value.trim() !== '') {
				form.reset();
				setStatus('success', SUCCESS_MSG);
				return;
			}

			statusEl.hidden = true;
			delete statusEl.dataset.state;
			submitBtn.disabled = true;
			const original = btnLabel.textContent;
			btnLabel.textContent = 'Sending…';

			try {
				const data = new FormData(form);
				data.delete('hp_field');
				const res = await fetch(KIT_ENDPOINT, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: data,
				});

				if (res.ok) {
					form.reset();
					setStatus('success', SUCCESS_MSG);
				} else {
					setStatus('error', ERROR_MSG);
				}
			} catch {
				setStatus('error', ERROR_MSG);
			} finally {
				submitBtn.disabled = false;
				btnLabel.textContent = original;
			}
		});
	}

	document.addEventListener('astro:page-load', initSignup);
</script>
