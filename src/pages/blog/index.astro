---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Published posts, newest first. Drafts are excluded in a production build.
const posts = (
	await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Format in UTC so a date-only frontmatter value (parsed as UTC midnight)
// doesn't shift a day in the build machine's local timezone.
const fmtDate = (d: Date) =>
	d.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: '2-digit',
		timeZone: 'UTC',
	});
---

<Layout
	title="Blog — Mike Wilson Digital"
	description="Notes from building an AI-first, repo-first website workflow in the open — decisions, tradeoffs, and the method."
>
	<main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16">
		<div class="max-w-3xl">
			<p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-text-muted">
				<span class="text-primary/70">~/</span>blog
			</p>
			<h1 class="mt-5 font-heading text-4xl font-black tracking-tight text-text sm:text-5xl">
				Building in the open
			</h1>
			<p class="mt-4 max-w-xl text-lg leading-relaxed text-text-muted">
				Notes from shipping production websites with an AI-first, repo-first workflow.
			</p>
		</div>

		{
			posts.length === 0 ? (
				<p class="mt-10 font-mono text-sm text-text-muted">
					<span class="text-text-muted/50">//</span> no posts published yet — check back soon.
				</p>
			) : (
				<ul class="mt-10 w-full border-t border-border">
					{posts.map((post) => (
						<li>
							<a
								href={`/blog/${post.id}/`}
								class="group flex flex-col gap-1 border-b border-border py-5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg sm:flex-row sm:items-baseline sm:gap-6"
							>
								<time
									datetime={post.data.pubDate.toISOString()}
									class="shrink-0 pt-0.5 font-mono text-xs tabular-nums text-text-muted"
								>
									{fmtDate(post.data.pubDate)}
								</time>
								<span class="flex-1">
									<span class="font-heading text-lg font-bold tracking-tight text-text transition-colors group-hover:text-primary">
										{post.data.title}
									</span>
									{post.data.tags && post.data.tags.length > 0 && (
										<span class="mt-1 block font-mono text-xs text-text-muted">
											{post.data.tags.map((t) => `#${t}`).join(' ')}
										</span>
									)}
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Layout>
