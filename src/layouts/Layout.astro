---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	/** Overrides og:title / twitter:title (defaults to `title`). */
	ogTitle?: string;
	/** Overrides og:description / twitter:description (defaults to `description`). */
	ogDescription?: string;
	/** Social share image, resolved to an absolute URL. */
	image?: string;
	noindex?: boolean;
	header?: boolean;
	footer?: boolean;
	/** When set, adds a BlogPosting node to the JSON-LD graph (blog posts). */
	article?: {
		title: string;
		description: string;
		/** ISO date string. */
		datePublished: string;
		/** ISO date string (defaults to datePublished). */
		dateModified?: string;
	};
}

const {
	title = 'Mike Wilson Digital — Launching Soon',
	description = 'Mike Wilson Digital is launching soon. A repository-first digital studio. Have a question? Send a message.',
	ogTitle,
	ogDescription,
	image = '/og.png',
	noindex = false,
	header = true,
	footer = true,
	article,
} = Astro.props;

// Commit SHA of this build (set by Cloudflare Pages). Used by the
// post-deploy cache-purge workflow to detect when a deploy is live.
const commitSha = process.env.CF_PAGES_COMMIT_SHA || 'dev';

// Canonical + absolute social image (self-referencing, www).
const siteURL = Astro.site ?? new URL('https://www.mikewilson.digital');
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const ogImageURL = new URL(image, siteURL).href;
const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

// Sitewide structured data: Person + Organization + WebSite.
const origin = siteURL.origin;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${origin}/#person`,
			name: 'Mike Wilson',
			url: origin,
			worksFor: { '@id': `${origin}/#organization` },
			sameAs: [
				'https://www.linkedin.com/in/mwilson51/',
				'https://x.com/MikeWilson51',
				'https://github.com/mwilson777',
				'https://www.instagram.com/mrobertwilson',
				'https://www.facebook.com/mikerobertwilson',
			],
		},
		{
			'@type': 'Organization',
			'@id': `${origin}/#organization`,
			name: 'Mike Wilson Digital LLC',
			url: origin,
			founder: { '@id': `${origin}/#person` },
		},
		{
			'@type': 'WebSite',
			'@id': `${origin}/#website`,
			name: 'Mike Wilson Digital',
			url: origin,
		},
		...(article
			? [
					{
						'@type': 'BlogPosting',
						'@id': `${canonicalURL}#article`,
						headline: article.title,
						description: article.description,
						datePublished: article.datePublished,
						dateModified: article.dateModified ?? article.datePublished,
						author: { '@id': `${origin}/#person` },
						publisher: { '@id': `${origin}/#organization` },
						mainEntityOfPage: canonicalURL,
						url: canonicalURL,
						image: ogImageURL,
					},
				]
			: []),
	],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Apply the saved theme before first paint (defaults to dark) to avoid a flash -->
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t !== 'light' && t !== 'dark') t = 'dark';
					document.documentElement.setAttribute('data-theme', t);
					document.documentElement.style.colorScheme = t;
				} catch (e) {}
			})();
		</script>

		<!-- Re-apply the saved theme after each View Transition swap (no nav flip) -->
		<script is:inline>
			document.addEventListener('astro:after-swap', function () {
				try {
					var t = localStorage.getItem('theme');
					if (t !== 'light' && t !== 'dark') t = 'dark';
					document.documentElement.setAttribute('data-theme', t);
					document.documentElement.style.colorScheme = t;
				} catch (e) {}
			});
		</script>

		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-NPHB48ZL');
		</script>
		<!-- End Google Tag Manager -->

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0b1220" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="build-commit" content={commitSha} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mike Wilson Digital" />
		<meta property="og:title" content={socialTitle} />
		<meta property="og:description" content={socialDescription} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={socialTitle} />
		<meta name="twitter:description" content={socialDescription} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Structured data: Person + Organization + WebSite -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Fonts — self-hosted (Satoshi / Sentient / Commit Mono); @font-face in global.css.
		     Preload the two most critical faces: Satoshi 900 (hero H1) + Sentient 400 (body). -->
		<link rel="preload" href="/fonts/satoshi-900.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Swallow only the benign View-Transition abort (a superseded/interrupted
		     transition rejects with InvalidStateError) so the console stays clean. -->
		<script is:inline>
			(function () {
				function isBenignVTAbort(err) {
					return (
						err &&
						err.name === 'InvalidStateError' &&
						/Transition was aborted/.test(err.message || '')
					);
				}
				window.addEventListener('unhandledrejection', function (e) {
					if (isBenignVTAbort(e.reason)) e.preventDefault();
				});
				window.addEventListener('error', function (e) {
					if (isBenignVTAbort(e.error)) e.preventDefault();
				});
			})();
		</script>

		<!-- SPA-style nav cross-fade; theme is re-applied on astro:after-swap above. -->
		<ClientRouter />

		<title>{title}</title>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NPHB48ZL"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->

		<div class="flex min-h-screen flex-col">
			{header && <Header />}
			<slot />
			{footer && <Footer />}
		</div>

		<!-- For builders who open devtools. -->
		<script is:inline>
			console.log(
				'%c// built in the open — mikewilson.digital',
				'color:#f97316;font:600 13px ui-monospace,SFMono-Regular,monospace'
			);
			console.log(
				"%cLike what you see under the hood? Let's build → /contact",
				'color:#94a3b8;font:13px ui-monospace,SFMono-Regular,monospace'
			);
		</script>
	</body>
</html>
