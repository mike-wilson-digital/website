---
// Sitewide header — rendered by Layout on every page.
// Dark logo shows now; light logo is wired for the future light-mode toggle
// (swaps automatically with [data-theme]).
import logoDark from '../assets/logo/mw-digital-dark.svg';
import logoLight from '../assets/logo/mw-digital-light.svg';
---

<header class="mx-auto flex w-full max-w-5xl items-center px-6 py-6">
	<a
		href="/"
		class="inline-flex rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
	>
		<img
			src={logoDark.src}
			width={logoDark.width}
			height={logoDark.height}
			alt="[mw] digital — Mike Wilson Digital"
			class="hidden h-7 w-auto dark:block"
			loading="eager"
		/>
		<img
			src={logoLight.src}
			width={logoLight.width}
			height={logoLight.height}
			alt="[mw] digital — Mike Wilson Digital"
			class="h-7 w-auto dark:hidden"
			loading="eager"
		/>
	</a>
</header>
