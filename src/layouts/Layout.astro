---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	header?: boolean;
	footer?: boolean;
}

const {
	title = 'Mike Wilson Digital — Launching Soon',
	description = 'Mike Wilson Digital is launching soon. A repository-first digital studio. Have a question? Send a message.',
	noindex = false,
	header = true,
	footer = true,
} = Astro.props;

// Commit SHA of this build (set by Cloudflare Pages). Used by the
// post-deploy cache-purge workflow to detect when a deploy is live.
const commitSha = process.env.CF_PAGES_COMMIT_SHA || 'dev';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />

		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', 'GTM-NPHB48ZL');
		</script>
		<!-- End Google Tag Manager -->

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="build-commit" content={commitSha} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Fonts — Inter (Google) for body/UI, Satoshi (Fontshare) for headings -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap"
		/>

		<title>{title}</title>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-NPHB48ZL"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->

		<div class="relative flex min-h-screen flex-col overflow-hidden">
			<!-- Subtle orange hero glow on the dark background (sitewide) -->
			<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[75vh]">
				<div
					class="absolute left-1/2 top-[-25%] h-[75vh] w-[130vw] -translate-x-1/2 rounded-[50%] opacity-60 blur-[120px]"
					style="background: radial-gradient(closest-side, rgba(249,115,22,0.3), rgba(249,115,22,0.1) 55%, transparent 78%);"
				>
				</div>
			</div>

			{header && <Header />}
			<slot />
			{footer && <Footer />}
		</div>
	</body>
</html>
