---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Mike Wilson Digital — Launching Soon',
	description = 'Mike Wilson Digital is launching soon. A repository-first digital studio. Have a question? Send a message.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Fonts — Inter (Google) for body/UI, Satoshi (Fontshare) for headings -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap"
		/>

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
