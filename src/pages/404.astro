---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page not found — Mike Wilson Digital"
	description="This page doesn't exist, or it moved."
	noindex
>
	<main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16">
		<article class="prose">
			<p class="font-mono text-sm text-text-muted"><span class="text-primary">//</span> 404</p>
			<h1>Page not found</h1>
			<p>
				That page doesn't exist, or it moved. Try the <a href="/">homepage</a> or the
				<a href="/blog/">blog</a>.
			</p>
		</article>
	</main>
</Layout>
