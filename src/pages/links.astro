---

<Layout
	title="Mike Wilson — Links"
	description="Mike Wilson — links, socials, and early access to the AI-first website starter kit."
	noindex
	header={false}
	footer={false}
>
	<main class="flex w-full flex-1 flex-col items-center px-5 py-10">
		<div class="flex w-full max-w-[460px] flex-1 flex-col">
			<!-- Identity (avatar placeholder — swap for a real image later) -->
		<div class="flex flex-col items-center text-center">
			<div
				class="flex h-20 w-20 items-center justify-center rounded-full font-heading text-2xl font-bold text-[#0b1220] shadow-lg shadow-cta/10"
				style="background: linear-gradient(145deg, #fdba74, #f97316);"
				aria-hidden="true"
			>
				MW
			</div>
			<h1 class="mt-5 font-heading text-2xl font-bold tracking-tight text-text">Mike Wilson</h1>
			<p class="mt-2 text-sm leading-relaxed text-text-muted">
				How I build fast, production-ready websites — AI-first, in the open.
			</p>
		</div>

		<!-- Email signup — the primary goal -->
		<div class="mt-8 w-full">
			<p class="text-center text-sm font-medium text-text">Get early access to the AI-first workflow I'm building.</p>
			<SignupForm class="mt-3" />
		</div>

		<!-- Link stack -->
		<nav class="mt-8 flex w-full flex-col gap-3" aria-label="Links">
			{
				links.map((link) => (
					<a
						href={link.href}
						data-link={link.name}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
						aria-label={link.external ? `${link.name} (opens in a new tab)` : link.name}
						class="group flex items-center gap-3 rounded-xl border border-border bg-surface/60 px-4 py-3.5 text-text transition hover:border-primary/50 hover:bg-surface focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
					>
						<svg
							viewBox="0 0 24 24"
							fill="currentColor"
							class="h-5 w-5 shrink-0 text-text-muted transition-colors group-hover:text-primary"
							aria-hidden="true"
						>
							<path d={link.icon} />
						</svg>
						<span class="font-medium">{link.name}</span>
						<svg
							viewBox="0 0 20 20"
							fill="currentColor"
							class="ml-auto h-4 w-4 shrink-0 text-text-muted transition-transform group-hover:translate-x-0.5"
							aria-hidden="true"
						>
							<path d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" />
						</svg>
					</a>
				))
			}
		</nav>

		<!-- Minimal footer (buttons above are the socials) -->
		<footer class="mt-auto pt-10 text-center text-xs text-text-muted">
			&copy; 2026 MikeWilson.Digital
			<span class="mx-1.5 text-text-muted/50" aria-hidden="true">&middot;</span>
			<a
				href="/privacy"
				class="rounded-sm underline-offset-2 transition-colors hover:text-primary hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
				>Privacy Policy</a
			>
		</footer>
		</div>
	</main>
</Layout>

<script>
	// Lightweight click tracking → dataLayer for GA4 (via GTM).
	document.querySelectorAll<HTMLElement>('[data-link]').forEach((el) => {
		el.addEventListener('click', () => {
			const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
			w.dataLayer = w.dataLayer || [];
			w.dataLayer.push({ event: 'link_click', link_name: el.dataset.link });
		});
	});
</script>
