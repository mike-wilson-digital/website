---
// Sitewide header — rendered by Layout on every page.
// Dark logo shows now; light logo is wired for the light-mode toggle
// (swaps automatically with [data-theme]).
import logoDark from '../assets/logo/mw-digital-dark.svg';
import logoLight from '../assets/logo/mw-digital-light.svg';
---

<header class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-6">
	<a
		href="/"
		aria-label="Mike Wilson Digital — home"
		class="-ml-[9px] inline-flex rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg sm:-ml-[10px]"
	>
		<img
			src={logoDark.src}
			width={logoDark.width}
			height={logoDark.height}
			alt="[mw] digital — Mike Wilson Digital"
			class="hidden h-8 sm:h-9 w-auto dark:block"
			loading="eager"
		/>
		<img
			src={logoLight.src}
			width={logoLight.width}
			height={logoLight.height}
			alt="[mw] digital — Mike Wilson Digital"
			class="h-8 sm:h-9 w-auto dark:hidden"
			loading="eager"
		/>
	</a>

	<button
		id="theme-toggle"
		type="button"
		aria-label="Switch to light mode"
		class="-mr-2 rounded-md p-2 text-text-muted transition-colors hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
	>
		<!-- Sun: shown in dark mode (tap → light) -->
		<svg class="hidden h-5 w-5 dark:block" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			<path
				d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM6.464 14.596a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.596 15.657a.75.75 0 0 0 1.06-1.06l-1.06-1.061a.75.75 0 1 0-1.06 1.06l1.06 1.06ZM5.404 6.464a.75.75 0 0 0 1.06-1.06l-1.06-1.06a.75.75 0 1 0-1.061 1.06l1.06 1.06Z"
			></path>
		</svg>
		<!-- Moon: shown in light mode (tap → dark) -->
		<svg class="h-5 w-5 dark:hidden" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			<path
				d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z"
			></path>
		</svg>
	</button>
</header>

<script>
	const btn = document.getElementById('theme-toggle');
	const root = document.documentElement;
	let transitionTimer: number | undefined;

	const syncLabel = () => {
		const isDark = root.getAttribute('data-theme') !== 'light';
		btn?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
	};

	syncLabel();

	btn?.addEventListener('click', () => {
		const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
		// Enable the cross-theme transition just for this flip, then remove it.
		root.classList.add('theme-transition');
		root.setAttribute('data-theme', next);
		root.style.colorScheme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {
			/* ignore */
		}
		syncLabel();
		window.clearTimeout(transitionTimer);
		transitionTimer = window.setTimeout(() => root.classList.remove('theme-transition'), 550);
	});
</script>
