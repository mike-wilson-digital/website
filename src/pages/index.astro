---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="relative flex min-h-screen flex-col overflow-hidden">
		<!-- Subtle orange hero glow on the dark background (dark-mode treatment) -->
		<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[75vh]">
			<div
				class="absolute left-1/2 top-[-25%] h-[75vh] w-[130vw] -translate-x-1/2 rounded-[50%] opacity-60 blur-[120px]"
				style="background: radial-gradient(closest-side, rgba(249,115,22,0.3), rgba(249,115,22,0.1) 55%, transparent 78%);"
			>
			</div>
		</div>

		<!-- Header -->
		<header class="mx-auto flex w-full max-w-5xl items-center gap-2.5 px-6 py-6">
			<span
				class="inline-block h-2.5 w-2.5 rounded-full"
				style="background: linear-gradient(145deg, #fdba74, #f97316);"
				aria-hidden="true"></span>
			<span class="font-heading text-sm font-bold tracking-tight text-text">Mike Wilson Digital</span>
		</header>

		<!-- Main -->
		<main class="mx-auto flex w-full max-w-2xl flex-1 flex-col items-center px-6 py-10">
			<!-- Hero -->
			<div class="flex flex-col items-center text-center">
				<span
					class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/40 px-3.5 py-1 text-xs font-medium uppercase tracking-[0.15em] text-text-muted backdrop-blur"
				>
					<span class="relative flex h-1.5 w-1.5">
						<span
							class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
							style="background:#f97316;"></span>
						<span class="relative inline-flex h-1.5 w-1.5 rounded-full" style="background:#f97316;"
						></span>
					</span>
					Launching Soon
				</span>

				<h1
					class="mt-6 font-heading text-4xl font-black leading-[1.05] tracking-tight text-text sm:text-5xl md:text-6xl"
				>
					Mike Wilson Digital<br />
					<span class="text-gradient-animated">Is Launching Soon</span>
				</h1>

				<p class="mt-6 max-w-xl text-lg leading-relaxed text-text-muted">
					I'm currently building the site and plan to launch sometime in August 2026. Stay tuned!
				</p>
			</div>

			<!-- Contact -->
			<section class="mt-14 w-full" aria-labelledby="contact-heading">
				<h2 id="contact-heading" class="font-heading text-xl font-bold tracking-tight text-text">
					Got a question? <span class="font-normal text-text-muted">Send me a message below.</span>
				</h2>

				<form
					id="contact-form"
					class="mt-6 rounded-2xl border border-border bg-surface/60 p-6 shadow-2xl shadow-black/40 backdrop-blur-sm sm:p-8"
					novalidate
				>
					<!-- Web3Forms -->
					<input type="hidden" name="access_key" value="a9f4b06a-c172-49e5-a00d-4007ea3889c1" />
					<input type="hidden" name="subject" value="New message from mikewilson.digital" />
					<input type="hidden" name="from_name" value="mikewilson.digital" />
					<!-- Honeypot (spam trap) — stays empty for humans -->
					<input
						type="checkbox"
						name="botcheck"
						class="hidden"
						style="display:none"
						tabindex="-1"
						autocomplete="off"
						aria-hidden="true"
					/>

					<div class="grid gap-5">
						<div class="field">
							<input
								id="name"
								name="name"
								type="text"
								required
								aria-required="true"
								autocomplete="name"
								placeholder=" "
							/>
							<label for="name">Name <span aria-hidden="true">*</span></label>
						</div>

						<div class="field">
							<input
								id="email"
								name="email"
								type="email"
								required
								aria-required="true"
								autocomplete="email"
								placeholder=" "
							/>
							<label for="email">Email <span aria-hidden="true">*</span></label>
						</div>

						<div class="field">
							<textarea
								id="message"
								name="message"
								rows="5"
								required
								aria-required="true"
								placeholder=" "></textarea>
							<label for="message">Message <span aria-hidden="true">*</span></label>
						</div>

						<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<p class="text-xs text-text-muted">
								<span aria-hidden="true">*</span> Required fields
							</p>
							<button
								id="submit-btn"
								type="submit"
								class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 font-semibold text-[#0b1220] shadow-lg shadow-primary/20 transition hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
							>
								<span data-label>Send</span>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 20 20"
									fill="currentColor"
									class="h-4 w-4"
									aria-hidden="true"
								>
									<path
										d="M3.105 2.289a.75.75 0 0 0-.826.95l1.414 4.926A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.085l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.155.75.75 0 0 0 0-1.114A28.897 28.897 0 0 0 3.105 2.289Z"
									></path>
								</svg>
							</button>
						</div>
					</div>

					<!-- Status: icon + text + role (never color alone) -->
					<div id="form-status" hidden></div>
				</form>
			</section>
		</main>

		<!-- Footer -->
		<footer class="mx-auto w-full max-w-5xl px-6 py-8 text-center text-sm text-text-muted">
			<div class="flex items-center justify-center gap-6">
				<a
					href="https://www.linkedin.com/in/mwilson51/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Mike Wilson on LinkedIn (opens in a new tab)"
					class="rounded-sm text-text-muted transition-colors hover:text-primary focus-visible:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
						></path>
					</svg>
				</a>
				<a
					href="https://github.com/mwilson777"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Mike Wilson on GitHub (opens in a new tab)"
					class="rounded-sm text-text-muted transition-colors hover:text-primary focus-visible:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
						<path
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path>
					</svg>
				</a>
				<a
					href="https://x.com/MikeWilson51"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Mike Wilson on X (opens in a new tab)"
					class="rounded-sm text-text-muted transition-colors hover:text-primary focus-visible:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
						<path
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
				</a>
			</div>
			<p class="mt-5">
				&copy; 2026 MikeWilson.Digital
				<span class="mx-1.5 text-text-muted/50" aria-hidden="true">&middot;</span>
				<a
					href="/privacy"
					class="rounded-sm underline-offset-2 transition-colors hover:text-primary hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
					>Privacy Policy</a
				>
			</p>
		</footer>
	</div>
</Layout>

<style>
	#form-status {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		margin-top: 1.25rem;
		padding: 0.75rem 1rem;
		border-radius: 0.6rem;
		font-size: 0.9rem;
		line-height: 1.45;
		border: 1px solid transparent;
	}
	#form-status[data-state='success'] {
		color: var(--color-success);
		background: color-mix(in srgb, var(--color-success) 12%, transparent);
		border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
	}
	#form-status[data-state='error'] {
		color: var(--color-error);
		background: color-mix(in srgb, var(--color-error) 12%, transparent);
		border-color: color-mix(in srgb, var(--color-error) 35%, transparent);
	}
	#form-status .status-icon {
		flex: none;
		font-weight: 700;
	}

	/* --- Material-style outlined fields with a floating label ---
	   Token-driven (raw theme vars) so the fields swap with the theme. */
	.field {
		position: relative;
	}

	.field input,
	.field textarea {
		width: 100%;
		font: inherit; /* Inter, 16px */
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--field-border);
		border-radius: 0.5rem;
		padding: 0.9rem 1rem;
		outline: none;
		caret-color: var(--primary);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.field textarea {
		display: block;
		min-height: 8rem;
		resize: vertical;
	}

	.field input:hover,
	.field textarea:hover {
		border-color: var(--text-muted);
	}

	/* Focused control → orange accent (dark accent #F97316) */
	.field input:focus,
	.field textarea:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 1px var(--primary);
	}

	/* Hide the single-space placeholder that drives :placeholder-shown */
	.field input::placeholder,
	.field textarea::placeholder {
		color: transparent;
	}

	.field label {
		position: absolute;
		left: 0.65rem;
		top: 50%;
		transform: translateY(-50%);
		padding: 0 0.35rem;
		color: var(--text-muted); /* resting label = muted */
		font-size: 1rem;
		line-height: 1;
		pointer-events: none;
		transition:
			top 0.15s ease,
			font-size 0.15s ease,
			color 0.15s ease,
			background-color 0.15s ease;
	}

	/* Textarea: rest the label near the top, where text starts */
	.field textarea + label {
		top: 1.5rem;
	}

	/* Float on focus OR whenever the field has a value.
	   The :not(:placeholder-shown) rule is what keeps it up after blur. */
	.field input:focus + label,
	.field input:not(:placeholder-shown) + label,
	.field textarea:focus + label,
	.field textarea:not(:placeholder-shown) + label {
		top: 0;
		font-size: 0.75rem;
		background: var(--bg); /* notch matches the field fill */
		color: var(--text-muted); /* filled + blurred = muted */
	}

	/* While focused, the floated label matches the orange border */
	.field input:focus + label,
	.field textarea:focus + label {
		color: var(--primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.field input,
		.field textarea,
		.field label {
			transition: none;
		}
	}
</style>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const statusEl = document.getElementById('form-status') as HTMLDivElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const btnLabel = submitBtn.querySelector('[data-label]') as HTMLElement;

	function setStatus(state: 'success' | 'error', message: string) {
		statusEl.hidden = false;
		statusEl.dataset.state = state;
		statusEl.setAttribute('role', state === 'error' ? 'alert' : 'status');
		const icon = state === 'success' ? '✓' : '⚠'; // ✓ / ⚠
		statusEl.innerHTML = `<span class="status-icon" aria-hidden="true">${icon}</span><span>${message}</span>`;
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		statusEl.hidden = true;
		delete statusEl.dataset.state;

		submitBtn.disabled = true;
		const original = btnLabel.textContent;
		btnLabel.textContent = 'Sending…';

		try {
			const payload = Object.fromEntries(new FormData(form).entries());
			const res = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(payload),
			});
			const result = await res.json();

			if (res.ok && result.success) {
				form.reset();
				setStatus('success', "Thanks — your message is on its way. I'll get back to you soon.");
			} else {
				setStatus('error', result.message || 'Something went wrong. Please try again.');
			}
		} catch {
			setStatus('error', 'Network error. Please check your connection and try again.');
		} finally {
			submitBtn.disabled = false;
			btnLabel.textContent = original;
		}
	});
</script>
